# Slack Incoming Webhook URL
# Slack 워크스페이스에서 생성한 Webhook URL을 입력하세요
# https://api.slack.com/messaging/webhooks 에서 생성 가능
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# 서버 포트 (기본값: 4000)
PORT=4000

# ngrok Authtoken (선택사항, 외부 접근이 필요한 경우)
# https://dashboard.ngrok.com/get-started/your-authtoken 에서 발급
# NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# ngrok 고정 도메인 (선택사항, 유료 플랜에서 설정한 경우)
# https://dashboard.ngrok.com/domains 에서 설정
# NGROK_DOMAIN=your-domain.ngrok.app
